# --- Événement ---
EVENT_NAME=Gala de la Jeunesse
EVENT_SUBTITLE=Un selfie suffit pour retrouver vos photos de la soirée
ORGANIZER=EBPA
# Identifiant court, sert de dossier dans Cloudinary (changer = nouvel événement vide)
EVENT_SLUG=gala-ebpa
# Albums proposés au photographe (séparés par des virgules)
ALBUMS=Accueil,Cérémonie,Soirée
PRIMARY_COLOR=#1a3a5c
ACCENT_COLOR=#F29F2F

# --- Adresse publique (utilisée par le QR code) ---
PUBLIC_URL=https://gala-photos.onrender.com

# --- Accès ---
ADMIN_PASSWORD=choisir-un-mot-de-passe-fort
PHOTOGRAPHER_PASSWORD=choisir-un-autre-mot-de-passe
APP_SECRET=une-longue-chaine-aleatoire

# --- Reconnaissance faciale ---
# Distance max pour qu'une photo soit considérée comme "la vôtre" (plus petit = plus strict)
FACE_MATCH_THRESHOLD=0.5
# Marge au-delà du seuil : visages proposés à l'invité ("Est-ce vous ?")
FACE_CANDIDATE_MARGIN=0.1

# --- Galerie ---
# true : tout le monde peut voir toutes les photos sur /galerie
# false : chaque invité ne voit que ses photos (galerie et écran réservés à l'admin connecté)
PUBLIC_GALLERY=true

MAX_UPLOAD_MB=12
SEARCH_LIMIT=120

# --- Stockage : laisser vide = disque local (tests uniquement) ---
# Copier depuis Cloudinary > Dashboard > "API environment variable"
CLOUDINARY_URL=
